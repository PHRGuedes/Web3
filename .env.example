# ==============================================================================
# ReqFlow - Variáveis de Ambiente (.env)
# ==============================================================================
# ATENÇÃO: NUNCA comite o arquivo .env preenchido no Git.
# Copie este arquivo para .env e preencha com seus valores locais ou configure
# no painel do seu serviço de nuvem (Render, Railway, Fly.io, etc.).
# ==============================================================================

# Banco de dados local (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=requisitos_db

# String de Conexão com o Banco de Dados (PostgreSQL / Alembic)
# - Ambiente Local: postgresql://postgres:postgres@localhost:5433/requisitos_db
# - Ambiente Nuvem: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/requisitos_db

# Chave secreta de assinatura dos tokens JWT (gere uma chave forte para produção)
SECRET_KEY=sua_chave_secreta_super_segura_para_jwt_producao

# Algoritmo de criptografia do token (padrão: HS256)
ALGORITHM=HS256

# Tempo de expiração do token de acesso em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Porta da API (em nuvem provedores injetam automaticamente $PORT)
PORT=8000
